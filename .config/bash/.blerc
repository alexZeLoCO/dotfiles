# -_- mode: sh; mode: sh-bash -_-

# This ble.sh package version does not support prompt*ps1*\* options.

# Keep custom PS1 from ~/.config/bash/functions/load_prompt.bashrc untouched.

# Disable ble.sh right prompt/transient behavior (if enabled elsewhere).

bleopt rps1=
bleopt rps1_transient=

# Optional: hide ble.sh EOF marker for a cleaner custom prompt view.

bleopt prompt_eol_mark=

# Suppress ble.sh standalone "[ble: exit N]" line; exit status is shown in custom PS1.

function TRAPERR() {
return 0
}

# This ble.sh build handles indexed colors more reliably than truecolor in PS1.

bleopt term_index_colors=256
